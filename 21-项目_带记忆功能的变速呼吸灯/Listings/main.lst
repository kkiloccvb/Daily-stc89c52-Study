  39          // --- 存储逻辑 ---
  40          void Save_Speed(unsigned char speed) {
  41   1          TR0 = 0; // 写期间停掉定时器，防止干扰
  42   1          I2C_Start(); I2C_Send(0xA0); I2C_Send(0x01); // 存在地址1，不影响之前的地址0
  43   1          I2C_Send(speed); I2C_Stop();
