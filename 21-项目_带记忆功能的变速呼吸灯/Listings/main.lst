  24          // --- I2C 驱动 (你之前调通的慢速版) ---
  25          void I2C_Delay() { _nop_(); _nop_(); _nop_(); _nop_(); }
  26          void I2C_Start() { SDA=1; SCL=1; I2C_Delay(); SDA=0; I2C_Delay(); SCL=0; }
  27          void I2C_Stop()  { SDA=0; I2C_Delay(); SCL=1; I2C_Delay(); SDA=1; }
  28          void I2C_Send(unsigned char Byte) {
  29   1          unsigned char i;
  30   1          for(i=0; i<8; i++) { SDA=(Byte&(0x80>>i)); I2C_Delay(); SCL=1; I2C_Delay(); SCL=0; }
  31   1          SDA=1; I2C_Delay(); SCL=1; I2C_Delay(); SCL=0;
  32   1      }
  33          unsigned char I2C_Read() {
  34   1          unsigned char i, Byte=0; SDA=1; I2C_Delay();
  35   1          for(i=0; i<8; i++){ SCL=1; I2C_Delay(); if(SDA) Byte|=(0x80>>i); SCL=0; I2C_Delay(); }
  36   1          SDA=1; I2C_Delay(); SCL=1; I2C_Delay(); SCL=0; return Byte;
  37   1      }
