   6          
   7          // --- 引脚定义 ---
   8          sbit LCD_CS   = P1^0;
   9          sbit LCD_RST  = P1^1;
  10          sbit LCD_RS   = P1^2; 
  11          sbit LCD_SDA  = P1^3; 
  12          sbit LCD_SCL  = P1^4;
  13          
  14          // --- 标准 6x8 ASCII 字库 (仅包含 HELLO 字符) ---
  15          u8 code F6x8[][6] = {
  16              { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }, // 空格 [0]
  17              { 0x7F, 0x08, 0x08, 0x08, 0x7F, 0x00 }, // H [1]
  18              { 0x7F, 0x49, 0x49, 0x49, 0x41, 0x00 }, // E [2]
  19              { 0x7F, 0x40, 0x40, 0x40, 0x40, 0x00 }, // L [3]
  20              { 0x3E, 0x41, 0x41, 0x41, 0x3E, 0x00 }  // O [4]
  21          };
  22          
  23          void Delay_ms(u16 ms) {
  24   1          u16 i, j;
  25   1          for(i=ms; i>0; i--) for(j=114; j>0; j--);
  26   1      }
  27          
  28          void W_Byte(u8 dat, u8 is_data) {
  29   1          u8 i;
  30   1          LCD_CS = 0;
  31   1          LCD_RS = is_data; 
  32   1          for(i=0; i<8; i++) {
  33   2              LCD_SCL = 0;
  34   2              if(dat & 0x80) LCD_SDA = 1; else LCD_SDA = 0;
  35   2              _nop_(); _nop_();
  36   2              LCD_SCL = 1; 
  37   2              _nop_(); _nop_();
  38   2              dat <<= 1;
  39   2          }
  40   1          LCD_CS = 1;
  41   1      }
  42          
  43          void LcdSetPos(u8 page, u8 x) {
  44   1          W_Byte(0xB0 + page, 0); 
  45   1          W_Byte(0x10 + (x >> 4), 0); 
  46   1          W_Byte(x & 0x0F, 0);
  47   1      }
  48          
  49          void LcdClear() {
  50   1          u8 p, c;
  51   1          for(p=0; p<6; p++) {
  52   2              LcdSetPos(p, 0);
  53   2              for(c=0; c<96; c++) W_Byte(0x00, 1);
  54   2          }
