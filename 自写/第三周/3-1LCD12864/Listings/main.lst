  56          
  57          // 显示一个 6x8 字符
  58          void ShowChar(u8 page, u8 x, u8 index) {
  59   1          u8 i;
  60   1          LcdSetPos(page, x);
  61   1          for(i=0; i<6; i++) {
  62   2              W_Byte(F6x8[index][i], 1);
  63   2          }
  64   1      }
  65          
  66          void LcdInit() {
  67   1          LCD_RST = 0; Delay_ms(100); LCD_RST = 1; Delay_ms(100);
  68   1          W_Byte(0xE2, 0); Delay_ms(20);
  69   1          W_Byte(0xA2, 0); // 1/9 bias
  70   1          W_Byte(0xA0, 0); // ADC 正常
  71   1          W_Byte(0xC8, 0); // COM 翻转
  72   1          W_Byte(0x23, 0); // 粗调对比度
  73   1          W_Byte(0x81, 0); // 微调指令
  74   1          W_Byte(0x30, 0); // 亮度 (如果看不清调这个)
  75   1          W_Byte(0x2F, 0); // 电源开启
  76   1          W_Byte(0xAF, 0); // 显示开启
  77   1          LcdClear();
  78   1      }
  79          
  80          void main() {
