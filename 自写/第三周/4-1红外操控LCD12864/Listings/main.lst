  58          // --- 基础驱动 ---
  59          void Delay_ms(u16 ms) { u16 i, j; for(i=ms; i>0; i--) for(j=114; j>0; j--); }
  60          void W_Byte(u8 dat, u8 is_data) {
  61   1          u8 i; LCD_CS = 0; LCD_RS = is_data; 
  62   1          for(i=0; i<8; i++) { LCD_SCL = 0; LCD_SDA = dat & 0x80; LCD_SCL = 1; dat <<= 1; }
  63   1          LCD_CS = 1;
  64   1      }
  65          void LcdSetPos(u8 p, u8 x) { W_Byte(0xB0 + p, 0); W_Byte(0x10 + (x >> 4), 0); W_Byte(x & 0x0F, 0); }
  66          void ShowChar(u8 p, u8 x, u8 ch) {
  67   1          u8 i, id = 0;
  68   1          if(ch=='K') id=1; else if(ch=='E') id=2; else if(ch=='Y') id=3; else if(ch==':') id=4;
  69   1          else if(ch>='0'&&ch<='9') id=ch-'0'+5; else if(ch=='M') id=17; else if(ch=='D') id=18;
  70   1          LcdSetPos(p, x); for(i=0; i<6; i++) W_Byte(F6x8[id][i], 1);
  71   1      }
  72          
  73          void LcdInit() {
  74   1          LCD_RST=0; Delay_ms(50); LCD_RST=1; Delay_ms(50);
  75   1          W_Byte(0xE2,0); W_Byte(0xA2,0); W_Byte(0xA0,0); W_Byte(0xC8,0);
  76   1          W_Byte(0x23,0); W_Byte(0x81,0); W_Byte(0x32,0); W_Byte(0x2F,0); W_Byte(0xAF,0);
  77   1          { u8 i, j; for(i=0;i<6;i++){ LcdSetPos(i,0); for(j=0;j<96;j++) W_Byte(0,1); } }
  78   1      }
