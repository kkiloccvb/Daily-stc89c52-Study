  80          // --- 中断解码 ---
  81          void ReadIr() interrupt 0 {
  82   1          u8 i, j, time; u16 timeout;
  83   1          timeout = 0; while(IRIN == 0 && timeout < 1000) { _nop_(); timeout++; } 
  84   1          if(timeout < 200) return;
  85   1          timeout = 0; while(IRIN == 1 && timeout < 500) { _nop_(); timeout++; }
  86   1          for(i=0; i<4; i++) {
  87   2              for(j=0; j<8; j++) {
  88   3                  timeout = 0; while(IRIN == 0 && timeout < 100) { _nop_(); timeout++; }
  89   3                  time = 0; while(IRIN == 1 && time < 100) { { u8 t=10; while(t--); } time++; }
  90   3                  IrValue[i] >>= 1; if(time > 7) IrValue[i] |= 0x80;
  91   3              }
  92   2          }
  93   1          if(IrValue[2] == (u8)~IrValue[3]) IrOK = 1;
  94   1      }
