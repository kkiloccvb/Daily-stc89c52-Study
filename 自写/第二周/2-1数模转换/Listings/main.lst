  27          // --- ADC 核心函数 ---
  28          unsigned char Read_AD(unsigned char cmd) {
  29   1          unsigned char i, dat = 0;
  30   1          AD_CS = 0;  // 开始通信
  31   1          AD_CLK = 0;
  32   1          
  33   1          // 写入命令
  34   1          for(i=0; i<8; i++) {
  35   2              AD_DIN = cmd & 0x80;
  36   2              cmd <<= 1;
  37   2              AD_CLK = 1; AD_CLK = 0; // 产生脉冲
  38   2          }
  39   1          
  40   1          // 芯片处理需要一点点微小的时间
  41   1          for(i=0; i<6; i++); 
  42   1      
  43   1          // 读取 8 位结果 (注意：XPT2046 实际上是 12 位，我们取高 8 位方便处理)
  44   1          for(i=0; i<8; i++) {
  45   2              AD_CLK = 1;
  46   2              dat <<= 1;
  47   2              if(AD_DOUT) dat |= 0x01;
  48   2              AD_CLK = 0;
  49   2          }
  50   1          AD_CS = 1; // 结束通信
  51   1          return dat;
  52   1      }
