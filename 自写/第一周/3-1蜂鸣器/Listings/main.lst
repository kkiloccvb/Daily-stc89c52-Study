   5          bit tick_flag = 0;         // 节拍标志位
   6          
   7          // 1. 定时器0：负责产生声音频率（高频）
   8          void Timer0_Init() {
   9   1          TMOD &= 0xF0; TMOD |= 0x01;
  10   1          TH0 = 0xF8; TL0 = 0x8C; // 初始设为 Do
  11   1          ET0 = 1; EA = 1; TR0 = 1;
  12   1      }
  13          
