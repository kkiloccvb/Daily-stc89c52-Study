  93          #include <REGX52.H>
  94          #include <stdio.h>
  95          
  96          // --- 引脚定义 ---
  97          // ADC/DAC 引脚 (周三)
  98          sbit AD_CS  = P3^5; 
  99          sbit AD_CLK = P3^6;
 100          sbit AD_DIN = P3^4;
 101          sbit AD_DOUT= P3^7;
 102          sbit DA_OUT = P2^1; 
 103          
 104          // I2C/EEPROM 引脚 (周四)
 105          sbit I2C_SCL = P2^0;
 106          sbit I2C_SDA = P2^1;
 107          
 108          // 按键引脚 (用于修改目标值)
 109          sbit K1 = P3^1; // 加
 110          sbit K2 = P3^0; // 减
 111          
 112          // --- 全局变量 ---
 113          unsigned char DA_Value = 0;    
 114          unsigned char PWM_Count = 0; 
 115          unsigned char Target_Value;     // 目标值（将从EEPROM读取）
 116          unsigned char Dead_Zone = 8;    
