 117          
 118          // ================== I2C & AT24C02 驱动 (存储) ==================
 119          
 120          void I2C_Start() { I2C_SDA=1; I2C_SCL=1; I2C_SDA=0; I2C_SCL=0; }
 121          void I2C_Stop()  { I2C_SDA=0; I2C_SCL=1; I2C_SDA=1; }
 122          void I2C_SendByte(unsigned char Byte) {
 123   1          unsigned char i;
 124   1          for(i=0; i<8; i++) { I2C_SDA=Byte&(0x80>>i); I2C_SCL=1; I2C_SCL=0; }
 125   1          I2C_SCL=1; I2C_SCL=0; // 简化的应答处理
 126   1      }
 127          unsigned char I2C_ReceiveByte() {
 128   1          unsigned char i, Byte=0; I2C_SDA=1;
 129   1          for(i=0; i<8; i++) { I2C_SCL=1; if(I2C_SDA) Byte|=(0x80>>i); I2C_SCL=0; }
 130   1          return Byte;
 131   1      }
 132          
 133          void Save_Target(unsigned char val) {
 134   1          I2C_Start(); I2C_SendByte(0xA0); I2C_SendByte(0x01); // 存在地址0x01
 135   1          I2C_SendByte(val); I2C_Stop();
 136   1          {unsigned int i=1000; while(i--);} // 等待5ms写入完成
 137   1      }
 138          
 139          unsigned char Load_Target() {
 140   1          unsigned char val;
 141   1          I2C_Start(); I2C_SendByte(0xA0); I2C_SendByte(0x01);
 142   1          I2C_Start(); I2C_SendByte(0xA1); val=I2C_ReceiveByte();
 143   1          I2C_SCL=1; I2C_SCL=0; I2C_Stop();
 144   1          return val;
 145   1      }
 146          
 147          // ================== ADC & PWM 驱动 (感知与执行) ==================
 148          
 149          unsigned char Read_AD(unsigned char cmd) {
 150   1          unsigned char i, dat=0; AD_CLK=0; AD_CS=0;
 151   1          for(i=0; i<8; i++) { AD_DIN=cmd&0x80; cmd<<=1; AD_CLK=1; AD_CLK=0; }
 152   1          for(i=0; i<8; i++) { AD_CLK=1; dat<<=1; if(AD_DOUT) dat|=1; AD_CLK=0; }
 153   1          AD_CS=1; return dat;
 154   1      }
 155          
 156          void Timer0_Init() { TMOD|=0x01; TH0=0xFF; TL0=0xA4; ET0=1; EA=1; TR0=1; }
 157          void Timer0_Routine() interrupt 1 {
 158   1          TH0=0xFF; TL0=0xA4; PWM_Count++;
 159   1          if(PWM_Count < DA_Value) DA_OUT=1; else DA_OUT=0;
 160   1      }
 161          
 162          // ================== 主程序 (系统逻辑) ==================
 163          
 164          void main() {
 165   1          unsigned char current_val;
 166   1          Timer0_Init();
 167   1          
 168   1          // 【周四新增】：开机第一件事，读取记忆
 169   1          Target_Value = Load_Target();
 170   1          if(Target_Value == 0xFF || Target_Value == 0) Target_Value = 128; // 第一次运行赋予默认值
 171   1      
 172   1          while(1) {
 173   2              current_val = Read_AD(0x94); // 获取当前值
 174   2      
 175   2              // 【周四新增】：按键修改目标并保存
 176   2              if(K1 == 0) { // 按下K1增加目标
 177   3                  while(K1==0); // 消抖
 178   3                  if(Target_Value < 240) Target_Value += 10;
C51 COMPILER V9.54   MAIN                                                                  04/04/2026 16:16:43 PAGE 4   

 179   3                  Save_Target(Target_Value); // 存入“硬盘”
 180   3              }
 181   2              if(K2 == 0) { // 按下K2减少目标
 182   3                  while(K2==0); 
 183   3                  if(Target_Value > 10) Target_Value -= 10;
 184   3                  Save_Target(Target_Value); // 存入“硬盘”
 185   3              }
 186   2      
 187   2              // 【周三核心】：闭环判断
 188   2              if(current_val > (Target_Value + Dead_Zone)) {
 189   3                  if(DA_Value > 0) DA_Value--; 
 190   3              }
 191   2              else if(current_val < (Target_Value - Dead_Zone)) {
 192   3                  if(DA_Value < 255) DA_Value++;
 193   3              }
 194   2      
 195   2              // 节拍控制
 196   2              {unsigned int i=5000; while(i--);} 
 197   2          }
 198   1      }


