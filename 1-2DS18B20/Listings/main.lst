  28          // --- LCD 驱动 ---
  29          void Lcd_WriteCmd(unsigned char cmd) {
  30   1          LCD_RS=0; LCD_RW=0; LCD_DataPort=cmd;
  31   1          LCD_EN=1; _nop_(); LCD_EN=0; DelayMs(2);
  32   1      }
  33          void Lcd_WriteData(unsigned char dat) {
  34   1          LCD_RS=1; LCD_RW=0; LCD_DataPort=dat;
