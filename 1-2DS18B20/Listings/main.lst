  42          // --- DS1302 慢时序读写 ---
  43          void DS1302_W(unsigned char dat) {
  44   1          unsigned char i;
  45   1          for(i=0; i<8; i++) {
  46   2              DS1302_IO = dat & 0x01;
  47   2              DS1302_SCLK = 1; _nop_(); _nop_(); // 增加脉冲宽度
  48   2              DS1302_SCLK = 0; _nop_(); _nop_();
  49   2              dat >>= 1;
  50   2          }
  51   1      }
  52          unsigned char DS1302_R() {
  53   1          unsigned char i, dat=0;
  54   1          for(i=0; i<8; i++) {
C51 COMPILER V9.54   MAIN                                                                  04/15/2026 22:05:10 PAGE 2   

  55   2              dat >>= 1;
