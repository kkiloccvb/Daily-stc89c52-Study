 108   2              // 如果读出来全是0，说明RTC没工作，显示 E 代替
 109   2              if(h==0 && m==0 && s==0) {
 110   3                  Lcd_WriteData('E'); Lcd_WriteData('r'); Lcd_WriteData('r');
 111   3              } else {
 112   3                  Lcd_WriteData(h/10 + '0'); Lcd_WriteData(h%10 + '0');
 113   3                  Lcd_WriteData(':');
 114   3                  Lcd_WriteData(m/10 + '0'); Lcd_WriteData(m%10 + '0');
 115   3                  Lcd_WriteData(':');
 116   3                  Lcd_WriteData(s/10 + '0'); Lcd_WriteData(s%10 + '0');
