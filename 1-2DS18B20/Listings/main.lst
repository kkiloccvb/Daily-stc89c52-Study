  18          
  19          // --- 延时 ---
  20          void DelayMs(unsigned int ms) {
  21   1          unsigned char i, j;
  22   1          while(ms--) {
  23   2              i = 2; j = 239;
  24   2              do { while (--j); } while (--i);
  25   2          }
  26   1      }
